                { team: "AS Monaco", gp: 28, pts: 83.8, oppPts: 79.5, oreb: 11.5, dreb: 23.2, reb: 34.7, ast: 16.9, stl: 7.8, blk: 2.2, pf: 21.0, fg3m: 9.1, fg3a: 25.8, fgm: 30.2, fga: 63.1, ftm: 14.3, fta: 18.2, to: 11.5 },
                { team: "Olympiacos", gp: 28, pts: 82.5, oppPts: 76.8, oreb: 12.1, dreb: 25.1, reb: 37.2, ast: 20.5, stl: 6.8, blk: 3.2, pf: 19.2, fg3m: 9.4, fg3a: 25.0, fgm: 29.8, fga: 59.5, ftm: 13.5, fta: 16.9, to: 12.4 },
                { team: "Fenerbahce", gp: 28, pts: 83.1, oppPts: 80.2, oreb: 10.2, dreb: 24.2, reb: 34.4, ast: 18.2, stl: 7.1, blk: 2.8, pf: 20.8, fg3m: 10.5, fg3a: 28.1, fgm: 29.5, fga: 61.2, ftm: 13.6, fta: 16.5, to: 12.0 },
                { team: "Virtus Bologna", gp: 27, pts: 81.0, oppPts: 82.1, oreb: 9.8, dreb: 23.5, reb: 33.3, ast: 17.8, stl: 6.5, blk: 2.5, pf: 21.8, fg3m: 8.8, fg3a: 24.5, fgm: 29.2, fga: 60.5, ftm: 13.8, fta: 17.8, to: 13.0 }
            ];

            renderPlayers(playersData);
            renderTeams(teamsData);
        }

        function renderPlayers(data) {
            const tbody = document.getElementById('playersBody');
            tbody.innerHTML = "";
            data.forEach(p => {
                const fg3Pct = calcPct(p.fg3m, p.fg3a);
                const fgPct = calcPct(p.fgm, p.fga);
                const ftPct = calcPct(p.ftm, p.fta);
                const row = `<tr>
                    <td><strong>${p.name}</strong></td>
                    <td>${p.team}</td>
                    <td>${p.gp}</td>
                    <td>${p.min}</td>
                    <td><strong>${p.pts}</strong></td>
                    <td>${p.oreb}</td>
                    <td>${p.dreb}</td>
                    <td><strong>${p.reb}</strong></td>
                    <td>${p.ast}</td>
                    <td>${p.stl}</td>
                    <td>${p.blk}</td>
                    <td>${p.pf}</td>
                    <td>${p.fg3m}-${p.fg3a}</td>
                    <td>${fg3Pct}</td>
                    <td>${p.fgm}-${p.fga}</td>
                    <td>${fgPct}</td>
                    <td>${p.ftm}-${p.fta}</td>
                    <td>${ftPct}</td>
                    <td>${p.to}</td>
                    <td><strong>${p.pir}</strong></td>
                </tr>`;
                tbody.innerHTML += row;
            });
        }

        function renderTeams(data) {
            const tbody = document.getElementById('teamsBody');
            tbody.innerHTML = "";
            data.forEach(t => {
                const fg3Pct = calcPct(t.fg3m, t.fg3a);
                const fgPct = calcPct(t.fgm, t.fga);
                const ftPct = calcPct(t.ftm, t.fta);
                const row = `<tr>
                    <td><strong>${t.team}</strong></td>
                    <td>${t.gp}</td>
                    <td><strong>${t.pts}</strong></td>
                    <td><span style="color:#f87171;">${t.oppPts}</span></td>
                    <td>${t.oreb}</td>
                    <td>${t.dreb}</td>
                    <td><strong>${t.reb}</strong></td>
                    <td>${t.ast}</td>
                    <td>${t.stl}</td>
                    <td>${t.blk}</td>
                    <td>${t.pf}</td>
                    <td>${t.fg3m}-${t.fg3a}</td>
                    <td>${fg3Pct}</td>
                    <td>${t.fgm}-${t.fga}</td>
                    <td>${fgPct}</td>
                    <td>${t.ftm}-${t.fta}</td>
                    <td>${ftPct}</td>
                    <td>${t.to}</td>
                </tr>`;
                tbody.innerHTML += row;
            });
        }

        function switchTab(tab) {
            document.getElementById('section-players').classList.remove('active');
            document.getElementById('section-teams').classList.remove('active');
            document.getElementById('btn-players').classList.remove('active');
            document.getElementById('btn-teams').classList.remove('active');

            if(tab === 'players') {
                document.getElementById('section-players').classList.add('active');
                document.getElementById('btn-players').classList.add('active');
            } else {
                document.getElementById('section-teams').classList.add('active');
                document.getElementById('btn-teams').classList.add('active');
            }
            document.getElementById('searchInput').value = "";
            filterTable();
        }

        // Ricerca in tempo reale per lettere consecutive
        function filterTable() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const activeSection = document.querySelector('.table-section.active');
            const table = activeSection.querySelector('table');
            const rows = table.querySelectorAll('tbody tr');

            rows.forEach(row => {
                let match = false;
                const cells = row.querySelectorAll('td');
                cells.forEach(cell => {
                    if (cell.textContent.toLowerCase().includes(query)) {
                        match = true;
                    }
                });
                row.style.display = match ? "" : "none";
            });
        }

        // Ordinamento a 3 stati cliccando sulle intestazioni
        let sortDirections = {};
        function sortTable(tableId, colIndex) {
            const table = document.getElementById(tableId);
            const tbody = table.querySelector('tbody');
            const rowsArray = Array.from(tbody.querySelectorAll('tr'));
            
            const key = tableId + '-' + colIndex;
            let dir = sortDirections[key] || 'none';

            if (dir === 'none') dir = 'desc';
            else if (dir === 'desc') dir = 'asc';
            else dir = 'none';

            sortDirections[key] = dir;

            if (dir === 'none') {
                fetchEuroleagueData();
                return;
            }

            rowsArray.sort((a, b) => {
                let valA = a.querySelectorAll('td')[colIndex].textContent.trim();
                let valB = b.querySelectorAll('td')[colIndex].textContent.trim();

                if (valA.includes('-')) valA = valA.split('-')[0];
                if (valB.includes('-')) valB = valB.split('-')[0];

                valA = valA.replace('%', '');
                valB = valB.replace('%', '');

                const numA = parseFloat(valA);
                const numB = parseFloat(valB);

                if (!isNaN(numA) && !isNaN(numB)) {
                    return dir === 'desc' ? numB - numA : numA - numB;
                } else {
                    return dir === 'desc' ? valB.localeCompare(valA) : valA.localeCompare(valB);
                }
            });

            tbody.innerHTML = "";
            rowsArray.forEach(row => tbody.appendChild(row));
        }

        // Avvio caricamento dati
        fetchEuroleagueData();

        // Script particelle 3D di sottofondo
        const container = document.getElementById('webgl-container');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        container.appendChild(renderer.domElement);
        const particlesGeometry = new THREE.BufferGeometry();
        const particlesCount = 1500;
        const posArray = new Float32Array(particlesCount * 3);
        for(let i = 0; i < particlesCount * 3; i++) { posArray[i] = (Math.random() - 0.5) * 10; }
        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
        const particlesMaterial = new THREE.PointsMaterial({ size: 0.015, color: 0xffffff, transparent: true, opacity: 0.6 });
        const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
        scene.add(particlesMesh);
        camera.position.z = 3;

        let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0;
        document.addEventListener('mousemove', (event) => {
            mouseX = (event.clientX - window.innerWidth / 2) / 500;
            mouseY = (event.clientY - window.innerHeight / 2) / 500;
        });

        function animate() {
            requestAnimationFrame(animate);
            targetX = mouseX * 0.5;
            targetY = mouseY * 0.5;
            particlesMesh.rotation.y += 0.001 + (targetX - particlesMesh.rotation.y) * 0.05;
            particlesMesh.rotation.x += 0.001 + (targetY - particlesMesh.rotation.x) * 0.05;
            renderer.render(scene, camera);
        }
        animate();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
