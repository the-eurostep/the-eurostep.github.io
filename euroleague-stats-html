                { name: "Nigel Hayes-Davis", team: "Fenerbahce", gp: 28, min: 32.5, pts: 16.8, oreb: 1.1, dreb: 3.9, reb: 5.0, ast: 1.8, stl: 1.0, blk: 0.2, pf: 1.9, fg3m: 2.2, fg3a: 5.1, fgm: 6.0, fga: 11.5, ftm: 2.6, fta: 3.1, to: 1.1, pir: 19.1 },
                { name: "Shane Larkin", team: "Anadolu Efes", gp: 24, min: 29.5, pts: 15.5, oreb: 0.4, dreb: 2.4, reb: 2.8, ast: 5.1, stl: 1.0, blk: 0.1, pf: 2.0, fg3m: 2.8, fg3a: 6.9, fgm: 4.9, fga: 11.8, ftm: 2.9, fta: 3.3, to: 2.2, pir: 17.4 }
            ];

            const teamsData = [
                { team: "Real Madrid", gp: 28, pts: 85.5, oppPts: 78.2, oreb: 11.2, dreb: 24.5, reb: 35.7, ast: 19.8, stl: 7.2, blk: 3.1, pf: 20.5, fg3m: 10.2, fg3a: 27.5, fgm: 31.0, fga: 62.5, ftm: 13.3, fta: 16.8, to: 12.1 },
